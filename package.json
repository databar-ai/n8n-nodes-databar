{
  "name": "n8n-nodes-databar",
  "version": "0.3.1",
  "description": "n8n community node for Databar.ai - data enrichment, waterfalls, flows, and table management",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "databar",
    "enrichment",
    "data",
    "api",
    "integration",
    "automation",
    "workflow",
    "contact-enrichment",
    "company-data",
    "lead-enrichment",
    "data-provider"
  ],
  "license": "MIT",
  "homepage": "https://databar.ai",
  "author": {
    "name": "Databar",
    "email": "info@databar.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/databar-ai/n8n-nodes-databar.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DatabarApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Databar/Databar.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.50.4",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "21.1.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
